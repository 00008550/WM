{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local-loop conveniences, and the only reason `dotnet run` needs no environment variables.
  //
  // Neither value is a secret and neither can leave this machine: .dockerignore excludes this
  // file from the build context, so it is not in the wm-api image, and the signing key below is
  // listed in JwtOptions.PublishedSigningKeys — a host outside Development refuses to boot on it.
  // Change either value here and the host stops accepting it in Production, which is the point.
  "Jwt": {
    "SigningKey": "local-development-only-not-a-secret-do-not-deploy"
  },
  "Bootstrap": {
    // Seeds the `admin` account on a fresh development database (see IdentitySeeder). A real
    // install supplies its own via Bootstrap__AdminPassword; without one no administrator is
    // created at all, which is now true rather than merely claimed.
    "AdminPassword": "Admin!234567"
  },
  "DevSignIn": {
    // POST /api/dev/sign-in: tokens for any active user, no password (plan 011 P9), so an agent can
    // verify portal work in a browser. Mapped only in Development with this true; set anywhere
    // else, the host refuses to start. See CLAUDE.md for how an agent uses it.
    "Enabled": true
  }
}
