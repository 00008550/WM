{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=wm;Username=wm;Password=wm_dev_password"
  },
  "Jwt": {
    "Issuer": "wm-api",
    "Audience": "wm-clients",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "Bootstrap": {
    // Development convenience only. Production supplies this via
    // Bootstrap__AdminPassword and the install refuses to create an admin without it.
    "AdminPassword": "Admin!234"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
