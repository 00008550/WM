{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=wm;Username=wm;Password=wm_dev_password"
  },
  // This file ships inside the wm-api image (.dockerignore excludes only
  // appsettings.Development.json), so it carries no credential of any kind. Two used to live
  // here and both were working values: Jwt:SigningKey and Bootstrap:AdminPassword. They are now
  // in appsettings.Development.json, which the image never sees, and a deployment supplies its
  // own via Jwt__SigningKey and Bootstrap__AdminPassword. Outside Development the host refuses
  // to start without a signing key of its own — see JwtOptions.DescribeSigningKeyFault.
  "Jwt": {
    "Issuer": "wm-api",
    "Audience": "wm-clients",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "Build": {
    // Reported by /api/health/ready so a smoke check can tell which build answered it. Empty on
    // purpose: a customer install discloses nothing until it chooses to. The demo sets Build__Id
    // to the deployed commit SHA.
    "Id": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
