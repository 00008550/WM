         choice, and the same version, as the other module test projects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <!-- 008 P4 review: the /api/me/timesheet endpoint, mapped into an in-memory host. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service under test lives here; the People contract supplies EmployeeSummary, which the
         boundary decision reads. -->
    <ProjectReference Include="..\WM.Modules.TimeAttendance\WM.Modules.TimeAttendance.csproj" />
    <ProjectReference Include="..\..\People\WM.Modules.People\WM.Modules.People.csproj" />
  </ItemGroup>

</Project>
