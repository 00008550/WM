# WM production configuration. Copy to .env and set real values before deploying.
#   cp .env.example .env

# --- Secrets (required) ---------------------------------------------------
POSTGRES_PASSWORD=change_me_strong_password
RABBITMQ_PASSWORD=change_me_strong_password
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_at_least_32_characters_long_random
# IANA time zone this installation measures its days in (plan 008 P1). Required; the API
# refuses to start without a valid one. The demo's seeded sites are in Ljubljana.
INSTALLATION_ZONE=Europe/Ljubljana
# Initial 'admin' password for a fresh install (12+ chars). Change after first
# sign-in. If unset, the install starts but creates no administrator account.
WM_ADMIN_PASSWORD=change_me_initial_admin_password

# --- Deployment -----------------------------------------------------------
# Image source and version. Pin WM_VERSION per customer for controlled
# rollout and instant rollback (docker compose pull && up -d).
WM_REGISTRY=wm
WM_VERSION=latest

# Public URL/port the portal is served on.
PUBLIC_URL=http://localhost
PUBLIC_PORT=80

# --- Optional -------------------------------------------------------------
POSTGRES_DB=wm
POSTGRES_USER=wm
RABBITMQ_USER=wm

# Kafka retention. Default 400 days / 20GB — must cover the longest
# recalculation window you expect to replay. Increase for large sites, but
# always keep it bounded: an unbounded log will fill the disk.
KAFKA_RETENTION_HOURS=9600
KAFKA_RETENTION_BYTES=21474836480
